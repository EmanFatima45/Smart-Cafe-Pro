<?xml version="1.0" encoding="utf-8" ?>
<configuration>

  <!-- ============================================================
       SmartCafe Pro - Application Configuration
       ============================================================ -->

  <configSections>
    <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System.Configuration.ConfigurationManager">
      <section name="SmartCafePro.Properties.Settings" type="System.Configuration.ClientSettingsSection, System.Configuration.ConfigurationManager" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
    </sectionGroup>
  </configSections>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <!-- Database connection strings -->
  <connectionStrings>
    <!--
      PRIMARY CONNECTION (Windows Authentication - recommended for local dev)
      Change Server= to your SQL Server instance name.
      Examples:
        localhost
        localhost\SQLEXPRESS
        .\SQLEXPRESS
        192.168.1.100
        MYPC\MSSQLSERVER2022
    -->
    <add name="SmartCafeDB"
         connectionString="Server=localhost;Database=SmartCafeProDB;Integrated Security=true;TrustServerCertificate=true;Connection Timeout=30;MultipleActiveResultSets=true;"
         providerName="Microsoft.Data.SqlClient" />

    <!--
      ALTERNATIVE: SQL Server Authentication (username/password)
      Uncomment and fill in if not using Windows Authentication:
    -->
    <!--
    <add name="SmartCafeDB"
         connectionString="Server=localhost;Database=SmartCafeProDB;User Id=sa;Password=YourPassword123;TrustServerCertificate=true;"
         providerName="Microsoft.Data.SqlClient" />
    -->
  </connectionStrings>

  <appSettings>
    <!-- Application identity -->
    <add key="AppName"    value="SmartCafe Pro" />
    <add key="AppVersion" value="1.0.0" />

    <!-- UI defaults -->
    <add key="DefaultTheme"    value="Dark" />
    <add key="DefaultLanguage" value="en-US" />
    <add key="AutoRefreshSec"  value="60" />

    <!-- Business defaults (overridden by DB Settings table) -->
    <add key="DefaultTaxRate"     value="16" />
    <add key="DefaultCurrency"    value="PKR" />
    <add key="LoyaltyPointsRate"  value="10" />

    <!-- Auto backup -->
    <add key="AutoBackupEnabled" value="true" />
    <add key="BackupPath"        value="C:\SmartCafeBackup" />
    <add key="BackupIntervalMin" value="720" />
  </appSettings>

  <!-- User settings (saved between sessions) -->
  <userSettings>
    <SmartCafePro.Properties.Settings>
      <setting name="RememberedUser" serializeAs="String">
        <value />
      </setting>
      <setting name="WindowState" serializeAs="String">
        <value>Normal</value>
      </setting>
      <setting name="LastSelectedModule" serializeAs="String">
        <value>Dashboard</value>
      </setting>
    </SmartCafePro.Properties.Settings>
  </userSettings>

  <!-- Runtime settings for SQL performance -->
  <runtime>
    <gcServer enabled="true" />
    <gcConcurrent enabled="true" />
  </runtime>

</configuration>
